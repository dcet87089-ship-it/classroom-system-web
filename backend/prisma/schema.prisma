datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  userId    String   // student ID or teacher ID
  role      String   // "teacher" | "student" | "admin"
  major     String   @default("วิศวกรรมคอมพิวเตอร์")
  createdAt DateTime @default(now())
}

model Course {
  id        String   @id @default(uuid())
  code      String
  name      String
  teacherId String
  createdAt DateTime @default(now())
}

model Schedule {
  id        String   @id @default(uuid())
  studentId String
  code      String
  name      String
  day       String
  time      String?
  location  String?
  createdAt DateTime @default(now())
}

model Room {
  id              String   @id // 6-digit room code
  settings        Json     @default("{}")
  teacherLocation Json     @default("{\"lat\": 0, \"lng\": 0}")
  students        Json     @default("[]")
  chat            Json     @default("[]")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model History {
  id              String   @id @default(uuid())
  courseCode      String
  courseName      String
  teacherName     String
  sessionNum      String   @default("1")
  dateStr         String
  timestamp       DateTime @default(now())
  studentsData    Json     @default("[]")
  teacherLocation Json?    @default("{\"lat\": 0, \"lng\": 0}")
  createdAt       DateTime @default(now())
}
